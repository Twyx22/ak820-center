# Maintainer: AK820 decomp project
# Reconstruit depuis la décompilation de l'app officielle AJAZZ AK820 Pro 1.0.0.5
pkgname=ak820-center
pkgver=1.0.0
pkgrel=1
pkgdesc="Configuration native Linux du clavier AJAZZ AK820 Pro (éclairage, remap, RGB, macros, écran TFT)"
arch=('x86_64')
url=""
license=('MIT')
depends=('qt6-base' 'hidapi' 'hicolor-icon-theme')
makedepends=('cmake' 'gcc')
source=()
build() {
  cmake -S "$srcdir/../../app" -B "$srcdir/build" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$srcdir/build" -j"$(nproc)"
}
package() {
  install -Dm755 "$srcdir/build/ak820-center" "$pkgdir/usr/bin/ak820-center"
  install -Dm644 "$srcdir/../../extracted/app/layouts/rgb-keyboard.xml" \
    "$pkgdir/usr/share/ak820-center/rgb-keyboard.xml"
  install -Dm644 "$srcdir/../../extracted/app/skins/theme1/logo/logo.png" \
    "$pkgdir/usr/share/ak820-center/icon.png"
  install -Dm644 "$srcdir/ak820-center.desktop" \
    "$pkgdir/usr/share/applications/ak820-center.desktop"
  install -Dm644 "$srcdir/99-ajazz-ak820pro.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-ajazz-ak820pro.rules"
}
