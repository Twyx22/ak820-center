# AJAZZ AK820 Pro — accès utilisateur (WebHID, hidraw, libusb)
# Branché en filaire : l'app officielle liste 8009 et 800A.
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="800a", MODE="0660", GROUP="input", TAG+="uaccess"
# Dongle 2.4G (config via son interface vendor)
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="fdfd", MODE="0660", GROUP="input", TAG+="uaccess"
# Bluetooth
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="fefe", MODE="0660", GROUP="input", TAG+="uaccess"
